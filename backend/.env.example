# PMI中国AI项目管理社区 - 环境变量模板
# 复制此文件为 .env 并填写实际值

# ============================================
# 应用配置
# ============================================
ENVIRONMENT=development
VERSION=1.1.0
APP_NAME=PMI中国AI项目管理社区

# ============================================
# 安全配置（必填）
# ============================================
# SECRET_KEY 留空（推荐）：非生产环境启动时由系统自动生成随机强密钥（secrets.token_hex(32)）；
# 生产环境必须显式设置强随机值（openssl rand -hex 32），否则启动直接报错，避免以可猜测密钥运行。
SECRET_KEY=

# 初始管理员（首次启动自动创建；之后修改请到「系统设置 → 用户」或改此处后重启）
# 默认账号 admin / admin123 —— 出于安全，部署到公网前请务必修改此密码。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_FULL_NAME=系统管理员

# ============================================
# 数据库配置
# ============================================
# SQLite（开发环境）
DATABASE_URL=sqlite+aiosqlite:///./tw_ai_pms.db
# PostgreSQL（生产环境）
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tw_ai_pms

# ============================================
# Redis配置
# ============================================
# 内存模式（开发环境）
REDIS_URL=memory://
# 标准Redis（生产环境）
# REDIS_URL=redis://localhost:6379/0

# ============================================
# AI API密钥配置（可选；不填则 AI 功能不可用，但系统其余功能正常）
# 在「系统设置 → 大模型配置」中也可随时填写；填入任一厂商 Key 后 AI 功能即生效。
# ============================================

# OpenAI / Azure OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# 百度文心一言
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# 阿里通义千问
ALIYUN_API_KEY=sk-your-aliyun-api-key

# 腾讯混元
TENCENT_API_KEY=sk-your-tencent-api-key

# 智谱GLM
ZHIPU_API_KEY=your-zhipu-api-key

# Moonshot Kimi
MOONSHOT_API_KEY=sk-your-moonshot-api-key

# 通义千问（独立配置）
QWEN_API_KEY=sk-your-qwen-api-key

# 硅基流动
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key

# 自定义OpenAI兼容API
OPENAI_COMPATIBLE_API_KEY=your-compatible-api-key
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1

# ============================================
# LLM模型配置
# ============================================
LLM_MODEL=MiniMax-M2.7
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# ============================================
# 飞书配置
# ============================================
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ============================================
# Celery配置
# ============================================
CELERY_BROKER_URL=sync+memory://
CELERY_RESULT_BACKEND=cache+memory://

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO

# ============================================
# CORS配置
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ============================================
# 文件存储配置
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# ============================================
# 邮件配置
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@pmi.bj.cn

# ============================================
# 分页配置
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# 缓存配置
# ============================================
CACHE_TTL=300
CACHE_ENABLED=true
